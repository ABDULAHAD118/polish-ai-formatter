{
  "name": "textpolish-windows",
  "productName": "TextPolish",
  "version": "1.1.0",
  "description": "Rewrite your WhatsApp drafts with AI. Never sends messages.",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "start": "bash ../../scripts/sync-config.sh && electron .",
    "dist": "bash ../../scripts/sync-config.sh && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.textpolish.desktop",
    "productName": "TextPolish",
    "files": ["main.mjs", "composer.mjs", "shared/**/*"],
    "icon": "shared/icon.png",
    "directories": { "output": "../../dist/windows" },
    "publish": [{ "provider": "github", "owner": "ABDULAHAD118", "repo": "polish-ai-formatter" }],
    "win": { "target": "nsis", "artifactName": "TextPolish-Windows-Setup-${version}.${ext}" },
    "nsis": { "oneClick": true, "perMachine": false }
  }
}
