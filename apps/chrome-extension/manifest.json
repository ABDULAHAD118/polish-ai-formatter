{
  "manifest_version": 3,
  "name": "TextPolish: Message Formatter",
  "version": "1.1.0",
  "description": "Rewrite your message drafts professionally with local Ollama or your own AI key. Works with WhatsApp Web. Never sends messages.",
  "minimum_chrome_version": "120",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": ["storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": { "default_popup": "options/options.html", "default_title": "TextPolish: Message Formatter" },
  "options_ui": { "page": "options/options.html", "open_in_tab": true }
}
